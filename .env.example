# Copy to .env and fill in. Everything here is optional — with no keys at all
# the app still runs (SQLite + template reports).

# --- Database: Postgres (Supabase/Render) or leave blank for local SQLite ---
DATABASE_URL=

# --- AI provider: set ONE (or neither). Auto-selects Anthropic > Gemini. ---
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Paid alternative (wins if both are set)
ANTHROPIC_API_KEY=
# auto (default) | anthropic | gemini | none
AI_PROVIDER=auto

# --- Market data (all optional) ---
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=

# --- Security (all optional; unset == fully open API) ---
# API_SECRET: when set, requires header  X-API-Key: <value>  on every route
#   except /health and the docs. Must match NEXT_PUBLIC_API_SECRET on the frontend.
API_SECRET=
# FORCE_PASSWORD: gates the cache-delete / force-regenerate routes.
#   Must match NEXT_PUBLIC_FORCE_PASSWORD on the frontend.
FORCE_PASSWORD=
# Per-IP rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_PIPELINE=10/minute

# --- Misc ---
# PORTFOLIO_DB=portfolio.db
